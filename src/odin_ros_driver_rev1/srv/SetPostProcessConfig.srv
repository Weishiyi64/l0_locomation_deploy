# Request - set post-processing flags (hot-switch)
# Each flag: 0=disable, 1=enable, -1=keep unchanged
int8 send_image_raw
int8 send_image2_raw
int8 send_cloud_render
int8 send_undistort
int8 send_rectify
int8 send_opencv_undistort
---
# Response
bool success
string message
# Current state after applying changes
bool image_raw_enabled
bool image2_raw_enabled
bool cloud_render_enabled
bool undistort_enabled
bool rectify_enabled
bool opencv_undistort_enabled
