# Request - set adaptive mode parameters (only active when sensor_mode=3/Adaptive)
uint16 cdf_percentile     # CDF percentile threshold (1-10000, unit: 0.01%)
uint16 outdoor_threshold  # CDF distance >= this value classified as outdoor (mm)
---
# Response
bool success
int32 error_code   # 0=OK, other values from OdinResult enum
string message
