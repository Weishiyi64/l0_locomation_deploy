<launch>
  <!-- =====================================================================
       Odin ROS1 driver launch
       All driver / post-process / reprojector / pointcloud-to-depth /
       depth-to-pointcloud parameters are exposed as <arg> here so they can
       be overridden from the command line:
           roslaunch <packageName> driver.launch key:=value
       Ports / device SN are auto-handled by SDK discovery and are not
       configurable.

       Naming policy: launch arg names are kept identical to the node
       parameter names. Nearly all parameters are unique to a single node;
       the only cross-node sharing is `sync_queue_size` (reprojector +
       pointcloud_to_depth), which is declared once and feeds both nodes.
       For per-node overrides use the full node path, e.g.
           rosparam set /pointcloud_to_depth/sync_queue_size 20

       本 launch 文件把所有可调参数全部暴露为 <arg>，arg 名与节点参数名保持
       一致。绝大多数参数只属于一个节点，无歧义；唯一跨节点同名的参数是
       `sync_queue_size`（重投影 + 点云转深度图），声明一次同时下发两个节点。
       如需分别设置，请走全路径：rosparam set /<完整节点名>/<参数> <值>。
       端口、SN 等由 SDK 自动处理，不作为 launch 参数。
       ================================================================== -->

  <!-- ===================== General / 通用 ============================= -->
  <arg name="packageName" default="odin_ros_driver_rev1"/>
  <arg name="start_rviz"   default="true"/>
  <arg name="rviz_config"  default="$(eval find(arg('packageName')) + '/rviz/driver_view_ros1.rviz')"/>
  <!-- Final topic format: /{topic_prefix}/{model}/device{index}/ -->
  <arg name="topic_prefix" default="manifold"/>

  <!-- =============== Main driver: device / 主驱动设备 ================= -->
  <arg name="operating_mode"       default="normal"/>   <!-- normal | standby -->
  <arg name="discovery_timeout_ms" default="2000"/>

  <!-- =============== Main driver: image stream / 图像流 =============== -->
  <!-- 0 = use first capability from device -->
  <arg name="image_width"  default="0"/>
  <arg name="image_height" default="0"/>
  <arg name="image_fps"    default="0"/>
  <arg name="image_format" default="mjpeg"/>            <!-- mjpeg|yuyv|nv12|nv21|rgb24 -->

  <!-- =============== Main driver: frame ids / 坐标系名 ================ -->
  <arg name="raw_frame_id"        default="odom"/>
  <arg name="slam_frame_id"       default="odom"/>
  <arg name="image_frame_id"      default="odom"/>
  <arg name="image2_frame_id"     default="odom"/>
  <arg name="gray_image_frame_id" default="odom"/>
  <arg name="imu_frame_id"        default="odom"/>
  <arg name="odom_frame_id"       default="odom"/>
  <arg name="odom_child_frame_id" default="base_link"/>
  <arg name="map_frame_id"        default="map"/>

  <!-- =============== Main driver: TF switches / TF 开关 =============== -->
  <arg name="publish_tf_odom" default="true"/>
  <arg name="publish_tf_map"  default="true"/>

  <!-- =============== Main driver: runtime knobs / 运行期初值 =========== -->
  <arg name="confidence_threshold" default="7"/>        <!-- 0..255 -->
  <arg name="sensor_mode"          default="1"/>        <!-- 0=HDR 1=HighPeak 2=LowPeak 3=Adaptive -->
  <arg name="log_level"            default="1"/>        <!-- 0=ERROR 1=INFO 2=WARN 3=DEBUG -->

  <!-- =============== Main driver: odometry scaling (advanced) ========== -->
  <arg name="odom_position_scale"         default="1e-6"/>
  <arg name="odom_orientation_scale"      default="1e-6"/>
  <arg name="odom_linear_velocity_scale"  default="1e-6"/>
  <arg name="odom_angular_velocity_scale" default="1e-6"/>

  <!-- =============== pointcloud_reprojector_node ====================== -->
  <!-- NOTE: 'mode' is also overridden by reprojection_mode in
       config/control_command.yaml. The launch arg here is only the seed
       default. / 'mode' 还会被 control_command.yaml 中 reprojection_mode
       覆盖；此处仅为初始默认值。 -->
  <arg name="mode"            default="raw"/>            <!-- raw | slam -->
  <arg name="min_depth"       default="0.1"/>
  <arg name="max_depth"       default="50.0"/>
  <arg name="point_size"      default="2"/>
  <arg name="use_depth_color" default="true"/>
  <arg name="sync_slop"       default="0.1"/>

  <!-- =============== pointcloud_to_depth_node ========================= -->
  <arg name="scale"               default="7.0"/>
  <arg name="z_min"               default="0.1"/>
  <arg name="z_max"               default="50.0"/>
  <arg name="dilate_radius"       default="1"/>
  <arg name="use_z_buffer"        default="false"/>
  <arg name="edge_grad_threshold" default="0.75"/>
  <arg name="vis_depth_min"       default="0.1"/>
  <arg name="vis_depth_max"       default="5.0"/>
  <arg name="sync_slop_sec"       default="0.1"/>

  <!-- Shared by reprojector + pointcloud_to_depth. Override per-node via
       rosparam set /<node>/sync_queue_size <v> if needed.
       重投影 + 点云转深度图共用，如需分别设置请走全路径。 -->
  <arg name="sync_queue_size" default="10"/>

  <!-- =============== depth_to_pointcloud_node ========================= -->
  <!-- step=5 caps at 55k samples on 1280x1088; step=4 -> ~80k; step=3 -> ~140k -->
  <arg name="step"  default="4"/>
  <arg name="d_min" default="0.1"/>
  <arg name="d_max" default="100.0"/>

  <!-- ===================================================================
       Nodes / 节点
       =================================================================== -->

  <node pkg="$(arg packageName)" type="odin_ros_driver_node" name="odin_ros_driver" output="screen">
    <param name="topic_prefix"                value="$(arg topic_prefix)"                type="str"/>
    <param name="operating_mode"              value="$(arg operating_mode)"              type="str"/>
    <param name="discovery_timeout_ms"        value="$(arg discovery_timeout_ms)"        type="int"/>

    <param name="image_width"                 value="$(arg image_width)"                 type="int"/>
    <param name="image_height"                value="$(arg image_height)"                type="int"/>
    <param name="image_fps"                   value="$(arg image_fps)"                   type="int"/>
    <param name="image_format"                value="$(arg image_format)"                type="str"/>

    <param name="raw_frame_id"                value="$(arg raw_frame_id)"                type="str"/>
    <param name="slam_frame_id"               value="$(arg slam_frame_id)"               type="str"/>
    <param name="image_frame_id"              value="$(arg image_frame_id)"              type="str"/>
    <param name="image2_frame_id"             value="$(arg image2_frame_id)"             type="str"/>
    <param name="gray_image_frame_id"         value="$(arg gray_image_frame_id)"         type="str"/>
    <param name="imu_frame_id"                value="$(arg imu_frame_id)"                type="str"/>
    <param name="odom_frame_id"               value="$(arg odom_frame_id)"               type="str"/>
    <param name="odom_child_frame_id"         value="$(arg odom_child_frame_id)"         type="str"/>
    <param name="map_frame_id"                value="$(arg map_frame_id)"                type="str"/>

    <param name="publish_tf_odom"             value="$(arg publish_tf_odom)"             type="bool"/>
    <param name="publish_tf_map"              value="$(arg publish_tf_map)"              type="bool"/>

    <param name="confidence_threshold"        value="$(arg confidence_threshold)"        type="int"/>
    <param name="sensor_mode"                 value="$(arg sensor_mode)"                 type="int"/>
    <param name="log_level"                   value="$(arg log_level)"                   type="int"/>

    <param name="odom_position_scale"         value="$(arg odom_position_scale)"         type="double"/>
    <param name="odom_orientation_scale"      value="$(arg odom_orientation_scale)"      type="double"/>
    <param name="odom_linear_velocity_scale"  value="$(arg odom_linear_velocity_scale)"  type="double"/>
    <param name="odom_angular_velocity_scale" value="$(arg odom_angular_velocity_scale)" type="double"/>
  </node>

  <node pkg="$(arg packageName)" type="post_process_node" name="postprocess" output="screen">
    <rosparam command="load" file="$(eval find(arg('packageName')) + '/config/control_command.yaml')"/>
    <param name="topic_prefix" value="$(arg topic_prefix)" type="str"/>
  </node>

  <!-- Point cloud reprojection node. Enable/mode also loaded from control_command.yaml. -->
  <node pkg="$(arg packageName)" type="pointcloud_reprojector_node"
        name="pointcloud_reprojector" output="screen">
    <param name="topic_prefix"     value="$(arg topic_prefix)"     type="str"/>
    <param name="mode"             value="$(arg mode)"             type="str"/>
    <param name="min_depth"        value="$(arg min_depth)"        type="double"/>
    <param name="max_depth"        value="$(arg max_depth)"        type="double"/>
    <param name="point_size"       value="$(arg point_size)"       type="int"/>
    <param name="use_depth_color"  value="$(arg use_depth_color)"  type="bool"/>
    <param name="sync_queue_size"  value="$(arg sync_queue_size)"  type="int"/>
    <param name="sync_slop"        value="$(arg sync_slop)"        type="double"/>
  </node>

  <!-- PointCloud -> depth map verification node. -->
  <!-- Publishes /{prefix}/{model}/device{N}/pointcloud2depth/{depth,depth_color,depth_overlay}. -->
  <node pkg="$(arg packageName)" type="pointcloud_to_depth_node"
        name="pointcloud_to_depth" output="screen">
    <param name="topic_prefix"        value="$(arg topic_prefix)"        type="str"/>
    <param name="scale"               value="$(arg scale)"               type="double"/>
    <param name="z_min"               value="$(arg z_min)"               type="double"/>
    <param name="z_max"               value="$(arg z_max)"               type="double"/>
    <param name="dilate_radius"       value="$(arg dilate_radius)"       type="int"/>
    <param name="use_z_buffer"        value="$(arg use_z_buffer)"        type="bool"/>
    <param name="edge_grad_threshold" value="$(arg edge_grad_threshold)" type="double"/>
    <param name="vis_depth_min"       value="$(arg vis_depth_min)"       type="double"/>
    <param name="vis_depth_max"       value="$(arg vis_depth_max)"       type="double"/>
    <param name="sync_queue_size"     value="$(arg sync_queue_size)"     type="int"/>
    <param name="sync_slop_sec"       value="$(arg sync_slop_sec)"       type="double"/>
  </node>

  <!-- Depth -> dense XYZRGB cloud back-projection node. -->
  <!-- Publishes /{prefix}/{model}/device{N}/depth2cloud/cloud_color. -->
  <node pkg="$(arg packageName)" type="depth_to_pointcloud_node"
        name="depth_to_pointcloud" output="screen">
    <param name="topic_prefix" value="$(arg topic_prefix)" type="str"/>
    <param name="step"         value="$(arg step)"         type="int"/>
    <param name="d_min"        value="$(arg d_min)"        type="double"/>
    <param name="d_max"        value="$(arg d_max)"        type="double"/>
  </node>

  <group if="$(arg start_rviz)">
    <node pkg="rviz" type="rviz" name="odin_rviz"
          args="-d $(arg rviz_config)" output="screen"/>
  </group>
</launch>
