<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>legged_controllers</name>
  <version>0.0.0</version>
  <description>Legged robot controllers: IHardwareLayer interface, LeggedControlloop, LeggedController (state machine + neural network). Hardware-specific code lives in legged_real.</description>
  <maintainer email="starimpact@126.com">luvbot</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>urdf</depend>
  <depend>yaml-cpp</depend>
  <depend>luvbot_control_interfaces</depend>
  <depend>legged_deploy</depend>
  <depend>ament_index_cpp</depend>

  <!-- launch helpers: action_sequence_policy.py, one_start.launch.py -->
  <exec_depend>luvbot_cloud_bridge</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>joy</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
