#!/usr/bin/env bash
set -euo pipefail
text_wbc_share="$(ros2 pkg prefix --share legged_controllers)"
# Find assets beside this package's own install tree, rather than depending on
# the invoking shell's model PYTHONPATH or on the board's old system runtime.
text_wbc_model_root="${TEXT_WBC_MODEL_ROOT:-}"
if [[ -z "$text_wbc_model_root" ]]; then
  text_wbc_root="$text_wbc_share"
  while [[ "$text_wbc_root" != / && ! -d "$text_wbc_root/model_sources/text_to_motion" ]]; do
    text_wbc_root="$(dirname "$text_wbc_root")"
  done
  text_wbc_model_root="$text_wbc_root/model_sources/text_to_motion"
fi
if [[ ! -d "$text_wbc_model_root/deps/rknnlite" ]]; then
  echo "Missing workspace RKNNLite2 dependencies: $text_wbc_model_root/deps/rknnlite; set TEXT_WBC_MODEL_ROOT to the deployed model directory" >&2
  exit 2
fi
export PYTHONPATH="$text_wbc_model_root/deps${PYTHONPATH:+:$PYTHONPATH}"
export RKNN_RUNTIME_LIB="${RKNN_RUNTIME_LIB:-$text_wbc_model_root/runtime/librknnrt.so}"
if [[ ! -f "$RKNN_RUNTIME_LIB" ]]; then
  echo "Missing process-local RKNN runtime: $RKNN_RUNTIME_LIB" >&2
  exit 2
fi
exec "${TEXT_WBC_PYTHON:-/usr/bin/python3}" -B "$text_wbc_share/texttomotion/generate_wbc_json.py" "$@"
