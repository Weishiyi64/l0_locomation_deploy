<?xml version="1.0"?>
<package format="3">
  <name>luvbot_provisioning</name>
  <version>0.1.0</version>
  <description>BLE WiFi provisioning with C daemon and C++ ROS2 wrapper</description>
  <maintainer email="you@foo.com">you</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>pkg-config</build_depend>
  <depend>libglib2.0-dev</depend>
  <exec_depend>bluez</exec_depend>
  <exec_depend>sudo</exec_depend>
  <exec_depend>network-manager</exec_depend>
  <depend>ament_index_cpp</depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
