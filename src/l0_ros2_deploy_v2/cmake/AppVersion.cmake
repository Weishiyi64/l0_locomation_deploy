if(NOT DEFINED _AMENT_PACKAGE_NAME)
  ament_package_xml()
endif()

set(APP_VERSION_SUFFIX "-dev.1")
set(APP_VERSION "${${PROJECT_NAME}_VERSION}${APP_VERSION_SUFFIX}")

configure_file(
  "${CMAKE_CURRENT_LIST_DIR}/AppVersion.h.in"
  "${CMAKE_CURRENT_BINARY_DIR}/generated/AppVersion.h"
  @ONLY
)
include_directories("${CMAKE_CURRENT_BINARY_DIR}/generated")

file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/version.py"
  "# Generated by CMake. Do not edit.\n"
  "APP_PACKAGE_NAME = \"${PROJECT_NAME}\"\n"
  "APP_VERSION = \"${APP_VERSION}\"\n"
)
install(FILES "${CMAKE_CURRENT_BINARY_DIR}/version.py" DESTINATION "lib/${PROJECT_NAME}")
