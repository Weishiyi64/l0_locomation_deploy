<?xml version="1.0"?>
<package format="3">
  <name>legged_mujoco</name>
  <version>0.0.0</version>
  <description>MuJoCo simulation interface for legged robots (ROS2 port).</description>

  <maintainer email="luvbot@luvbot.com">luvbot</maintainer>
  <license>BSD-3-Clause</license>

  <!-- ament build system -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS2 dependencies -->
  <depend>rclcpp</depend>
  <depend>realtime_tools</depend>
  <depend>legged_msgs</depend>
  <depend>legged_controllers</depend>
  <depend>yaml-cpp</depend>
  <!-- system deps: we don't list OpenGL/glfw/mujoco here in ROS2 style;
       they are found by CMake find_package/find_library. -->

  <!-- optional tests / lint -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
