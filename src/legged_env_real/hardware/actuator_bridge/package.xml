<?xml version="1.0"?>
<package format="3">
  <name>actuator_bridge</name>
  <version>0.1.0</version>
  <description>Unified actuator CAN bridge supporting multiple motor vendors</description>

  <maintainer email="13756885217@163.com">YuxiGao</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>rclcpp</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>can_msgs</build_depend>
  <build_depend>socketcan_wrapper</build_depend>
  <build_depend>Boost</build_depend>
  <build_depend>yaml-cpp</build_depend>

  <exec_depend>rclcpp</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>can_msgs</exec_depend>
  <exec_depend>socketcan_wrapper</exec_depend>

  <export>
      <build_type>ament_cmake</build_type>
  </export>
</package>
